<Window x:Class="CRUD_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD_App"
        mc:Ignorable="d"
        Title="Warhammer 40k Army Maker" Height="800" Width="1000" Background="#121212" 
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CategoryStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Background" Value="#4A708B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
        <Style x:Key="BackButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#4A708B" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontSize"
                    Value="24" />
            <Setter Property="Width"
                    Value="50" />
            <Setter Property="Height"
                    Value="50" />
            <Setter Property="Margin"
                    Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#6291B0" />
                                <Setter Property="Cursor"
                                        Value="Hand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="Warhammer 40k Army Maker"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="30"
                   FontWeight="Bold"/>

        <!--<TextBlock Grid.Row="1" Grid.Column="0" Text="List of Units"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="24"/>-->
        
        <TextBlock Grid.Row="1" Grid.Column="1"
           Text="Your Army"
           Foreground="White"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"
           FontSize="24"/>

        <Button Grid.Column="0" Grid.Row="2" Name="BackButton" Visibility="Collapsed"
                Style="{StaticResource BackButtonStyle}"
                Content="←"
                HorizontalAlignment="Right"
                Click="BackToCategories_Click" />

        <Grid Grid.Row="2" Grid.Column="1" Margin="10">
            <StackPanel x:Name="CategoryView" Visibility="Visible">
                <!--CHARACTERS-->
                <Border Background="#2a2a2a" CornerRadius="8" Margin="0,5" Padding="15">
                    <Grid>
                        <TextBlock Text="CHARACTERS" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource CategoryStyle}"
                                Click="ShowCharacters_Click"
                                Height="40"
                                VerticalAlignment="Top">
                            <TextBlock Text="+" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <!--BATTLELINE-->
                <Border Background="#2a2a2a" CornerRadius="8" Margin="0,5" Padding="15">
                    <Grid>
                        <TextBlock Text="BATTLELINE" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource CategoryStyle}"
                                Click="ShowBattleline_Click">
                            <TextBlock Text="+" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <!--DEDICATED TRASNPORT-->
                <Border Background="#2a2a2a" CornerRadius="8" Margin="0,5" Padding="15">
                    <Grid>
                        <TextBlock Text="DEDICATED TRANSPORT" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource CategoryStyle}"
                                Click="ShowTransport_Click">
                            <TextBlock Text="+"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
                <!--OTHER DATASHEETS-->
                <Border Background="#2a2a2a" CornerRadius="8" Margin="0,5" Padding="15">
                    <Grid>
                        <TextBlock Text="OTHER DATASHEETS" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource CategoryStyle}"
                                Click="ShowOther_Click">
                            <TextBlock Text="+"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
                
            </StackPanel>

            <Grid x:Name="UnitSelectionView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="1"
                          Name="UnitList"
                          Margin="10" 
                          Background="#1e1e1e" 
                          BorderThickness="1"
                          BorderBrush="#333333">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="20,10,0,5" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!--1st column-->
                                    <Image Grid.Column="0" Source="{Binding Image}" Width="60" Height="100" Margin="0,0,15,0"/>
                                    <!--2st column-->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#222222"
                                               VerticalAlignment="Center"/>
                                    <!--3rd column-->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button FontSize="36"
                                                FontWeight="Bold"
                                                Width="50"
                                                Height="50"
                                                Background="White"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"
                                                Margin="0,0,0,5"
                                                Padding="0,0,0,5"
                                                VerticalContentAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                Click="AddUnit_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="+"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                        <!--dodaje tło do punktów-->
                                        <Border Grid.Column="2"
                                                Background="#4A708B"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <!--Binding łączy dane z tym co zostanie wysłane w pliku cs, w tym przypadku z właściwością Points-->
                                            <!--StringFormat użyłem żeby dodać na końcu pkt, dodatkowy nawias potrzebny żeby działało poprawnie-->
                                            <TextBlock Text="{Binding Points, StringFormat='{}{0} pkt'}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Grid>

        <Button Grid.Row="3" Grid.Column="1" Content="Close" 
                Height="60" Width="200" Background="#FFB300" 
                Click="Button_Click"></Button>
    </Grid>
</Window>

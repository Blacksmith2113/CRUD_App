<Window x:Class="CRUD_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD_App"
        mc:Ignorable="d"
        Title="Warhammer 40k Army Maker" Height="800" Width="1000" Background="#121212" 
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Warhammer 40k Army Maker"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="30"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="List of Units"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="24"/>
        
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Your Army"
           Foreground="White"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"
           FontSize="24"/>

        <Grid Grid.Row="2" Grid.Column="0" Margin="10">

            <StackPanel x:Name="CategoryView" Visibility="Visible">
                <TextBlock Text="Select Category" Foreground="#777777" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <Border Background="#2a2a2a" CornerRadius="8" Margin="0,5" Padding="15">
                    <Grid>
                        <TextBlock Text="CHARACTERS" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Width="40" Height="40" Content="+" 
                        FontSize="20" Background="#4A708B" Foreground="White"
                        Click="ShowCharacters_Click"/>
                    </Grid>
                </Border>

                <Border Background="#2a2a2a" CornerRadius="8" Margin="0,5" Padding="15">
                    <Grid>
                        <TextBlock Text="BATTLELINE" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Width="40" Height="40" Content="+" 
                        FontSize="20" Background="#4A708B" Foreground="White"
                        Click="ShowBattleline_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid x:Name="UnitSelectionView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="← Back to Categories" 
                HorizontalAlignment="Left" Margin="5" Background="Transparent" 
                Foreground="#4A708B" BorderThickness="0" Click="BackToCategories_Click"/>

                <ListView Grid.Row="2" Grid.Column="0" 
          Name="UnitList"
          Margin="10" 
          Background="#1e1e1e" 
          BorderThickness="1"
          BorderBrush="#333333">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="20,10,0,5" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding Image}" 
                           Width="60" Height="100" Margin="0,0,15,0"/>

                                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#222222"
                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button FontSize="36"
                                FontWeight="Bold"
                                Width="50"
                                Height="50"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Margin="0,0,0,5"
                                Padding="0,0,0,5"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="+"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                        </Button>
                                        <!--dodaje tło do punktów-->
                                        <Border Grid.Column="2"
                            Background="#4A708B"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                                            <!--Binding łączy dane z tym co zostanie wysłane w pliku cs, w tym przypadku z właściwością Points-->
                                            <!--StringFormat użyłem żeby dodać na końcu pkt, dodatkowy nawias potrzebny żeby działało poprawnie-->
                                            <TextBlock Text="{Binding Points, StringFormat='{}{0} pkt'}"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Grid>

        <Button Grid.Row="3" Grid.Column="1" Content="Close" 
                Height="60" Width="200" Background="#FFB300" 
                Click="Button_Click"></Button>
    </Grid>
</Window>
